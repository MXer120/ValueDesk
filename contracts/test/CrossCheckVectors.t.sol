    uint256 internal constant LEAF_COUNT = 5;

    function _leaf(uint256 i) internal pure returns (bytes32 leaf, bytes32[] memory proof) {
        if (i == 0) {
            leaf = 0x5009a894792b3febca3fda7b93bba65945bf09acca36a41b6c608f82616f988f;
            proof = new bytes32[](2);
            proof[0] = 0x6b45a0fe99768c1814110a44033dc7a47279d84878532590344ad123bb956229;
            proof[1] = 0xd89c3bddb8c31f7f76b1962e6045dea5bede9cc57f86fb80dee491be99c07bfb;
            return (leaf, proof);
        }
        if (i == 1) {
            leaf = 0x6b45a0fe99768c1814110a44033dc7a47279d84878532590344ad123bb956229;
            proof = new bytes32[](2);
            proof[0] = 0x5009a894792b3febca3fda7b93bba65945bf09acca36a41b6c608f82616f988f;
            proof[1] = 0xd89c3bddb8c31f7f76b1962e6045dea5bede9cc57f86fb80dee491be99c07bfb;
            return (leaf, proof);
        }
        if (i == 2) {
            leaf = 0xb672a2514eabc86dae9ab65fa259b03a7b82b4efa840c5f882ead1d85b7c9bc3;
            proof = new bytes32[](2);
            proof[0] = 0xffe9f4db5acfd45c5c7610df20719d9bdede6a86fd64254dd373cb9db8bc58ab;
            proof[1] = 0xe083ef4d3f5d2af0fa7e83bc1090af0a8abd5660ea03aed6fd35daadfffdab39;
            return (leaf, proof);
        }
        if (i == 3) {
            leaf = 0x33b1e9b492cdae88cd0d44e6cdec4a947f7fb3e8f8208c21b6243eeea153d0df;
            proof = new bytes32[](3);
            proof[0] = 0x0973138235f2f4dc27e5ef2a23bfc0a37fb785adec61083571823e14777a741e;
            proof[1] = 0xb672a2514eabc86dae9ab65fa259b03a7b82b4efa840c5f882ead1d85b7c9bc3;
            proof[2] = 0xe083ef4d3f5d2af0fa7e83bc1090af0a8abd5660ea03aed6fd35daadfffdab39;
            return (leaf, proof);
        }
        if (i == 4) {
            leaf = 0x0973138235f2f4dc27e5ef2a23bfc0a37fb785adec61083571823e14777a741e;
            proof = new bytes32[](3);
            proof[0] = 0x33b1e9b492cdae88cd0d44e6cdec4a947f7fb3e8f8208c21b6243eeea153d0df;
            proof[1] = 0xb672a2514eabc86dae9ab65fa259b03a7b82b4efa840c5f882ead1d85b7c9bc3;
            proof[2] = 0xe083ef4d3f5d2af0fa7e83bc1090af0a8abd5660ea03aed6fd35daadfffdab39;
            return (leaf, proof);
        }
        revert("no such leaf");
    }

    /// @notice The execution-leaf format v1 (spec §7.2), encoded independently in Solidity for record 0, and every
    ///         proof of the package's tree verified with OpenZeppelin's MerkleProof against the committed root.
    function test_executionCommitment() public pure {
        bytes memory head = abi.encode(
            keccak256("ValuescanExecution.v1"),
            CONTRACT,
            uint256(1),
            uint32(1),
            uint8(0),
            uint8(2),
            keccak256("0xabababababababababababababababababababababababababababababababab:902174"),
            uint64(1_790_000_030_123),
            uint8(1)
        );
        bytes memory tail = abi.encode(
            keccak256("BTC-USD"),
            uint8(0),
            false,
            uint256(15_000_000_000_000_000),
            uint256(70_010_500_000_000_000_000_000),
            uint16(50),
            bytes32(0x1212121212121212121212121212121212121212121212121212121212121212),
            uint64(1_790_000_030_211),
            uint16(0)
        );
        (bytes32 leaf0,) = _leaf(0);
        assertEq(keccak256(bytes.concat(keccak256(bytes.concat(head, tail)))), leaf0, "leaf format v1");
        for (uint256 i; i < LEAF_COUNT; ++i) {
            (bytes32 leaf, bytes32[] memory proof) = _leaf(i);
            assertTrue(MerkleProof.verify(proof, EXECUTIONS_ROOT, leaf), "proof");
        }
    }
