# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo
.vite/

# environment - secrets never enter git. .env.example files are the documented shape.
.env
.env.*
!.env.example
!**/.env.example

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# rejected first-draft UI, kept only for reference
archive/
!**/.env.local.example

# TradingView Advanced Charts - licensed, from TradingView's private repo.
# Copied in locally by the owner; never committed or redistributed.
apps/web/public/charting_library/

# live E2E runner: private config and run reports
apps/web/e2e/live/reports/
apps/web/e2e/live/config.json
apps/web/e2e/ui/.out/

# local secrets and machine state - never committed
.keystore.json
*.keystore.json
device.key
local-api.token
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
# key material in any container format (TLS, deploy keys, exported wallets)
*.pem
*.key
*.p12
*.pfx
*.jks

# agent staging copies
.tsc-stage/
.tsc-stage-*/

# builder fee tiers: the live config and the terms signing key stay on the machine
builder-tiers.json
builder-terms.key*

# Vercel: the link of `vercel link` and the Build Output of deploy/vercel/build.sh
.vercel/
apps/web/public/models/
