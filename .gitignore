dist/
*.tsbuildinfo
.vite/

# environment - secrets never enter git. .env.example files are the documented shape.
.env
.env.*
!.env.example
!**/.env.example

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# editor
.vscode/*
