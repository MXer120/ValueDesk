{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "paths": {
      "@sign/*": [
        "../server/src/*"
      ],
      "@sodex-core": [
        "../../packages/sodex-core/src/index.ts"
      ],
      "@copy-engine": [
        "../../packages/copy-engine/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "../server/src/signing",
    "../server/src/decimal.ts",
    "../../packages/sodex-core/src",
    "../../packages/copy-engine/src"
  ]
}
