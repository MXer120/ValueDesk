{
  "name": "@valuetrade/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "indexer": "tsx --disable-warning=ExperimentalWarning src/indexer/main.ts",
    "invites-dev": "tsx --disable-warning=ExperimentalWarning tools/invites-dev.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.1",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "fastify": "^5.12.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
