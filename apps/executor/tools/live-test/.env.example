# Copy this file to .env.live (same folder; git ignores it) and fill it in. Never commit it.
#
# The FOLLOWER: a dedicated wallet funded on SoDEX (see --budget for how much). The runner
# signs with this key: the copy terms, the executor's key registration, the builder-fee
# approval, and its own one-day key for the cleanup.
LIVE_FOLLOWER_KEY=
# The LEADER: a second wallet you control, funded on SoDEX. The runner trades it itself
# (real IOC orders) so the follower has a real trade to copy. Leave empty to skip copy trading.
LIVE_LEADER_KEY=
# Your country of residence (two letters, as you declare it in ValueDesk). EEA: 2x cap applies.
LIVE_COUNTRY=
# The copy terms version you have read and accept (the runner signs them in your name).
LIVE_ACCEPT_TERMS=
