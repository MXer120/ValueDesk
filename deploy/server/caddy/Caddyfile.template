# /etc/caddy/Caddyfile - written by bootstrap.sh from this template
# (__ORIGIN_DOMAIN__ and the email line are filled in). Topology B of
# docs/deploy/SECURITY-HEADERS.md section 2.3:
#
#   viewer -> the edge -> Caddy :443 (this file) -> /api/copy/*  127.0.0.1:8799 (valuescan-executor)
#                                                -> anything else 127.0.0.1:8797 (valuescan-api)
#
# The edge is CloudFront (deploy/aws/edge.yaml) or the Vercel function that proxies
# /api/* (deploy/vercel). Caddy is here for TLS between the edge and the origin,
# with a certificate it obtains and renews by itself - and for one gate in front of
# the API and the copy executor: only a request that carries the origin secret is
# passed on, to either of them.

{
	__ACME_EMAIL_LINE__

	# No admin endpoint. It listens on localhost:2019 by default, and anything on
	# this box - the API and the executor processes included - could reconfigure
	# Caddy through it. A config change is "systemctl restart caddy".
	admin off

	servers {
		# Keep the edge's X-Forwarded-For instead of replacing it with the edge's
		# own address: the API rate-limits by viewer (VALUESCAN_TRUST_PROXY=2), and
		# the executor takes the first address as the viewer (EXECUTOR_TRUST_EDGE=1).
		# Trusting every peer is safe ONLY because nothing reaches either of them
		# through here without the origin secret (the @edge matcher below): a client
		# that connects directly cannot choose its own rate-limit key - nor the
		# X-Viewer-Country the executor applies the country rules by. (Behind
		# CloudFront the security group also admits CloudFront's addresses only; the
		# Vercel functions have no published address range, so there port 443 is open.)
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

__ORIGIN_SITE_ADDRESSES__ {
	# Port 443 may be closed to everyone but the edge, so Let's Encrypt cannot
	# validate over TLS-ALPN. It validates over HTTP-01 on port 80, which the
	# security group opens for exactly that (and for the redirect to https).
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# THE GATE. The edge sends X-Origin-Verify on every request. Its value is one of
	# two (the current secret and, while it is rotated, the next one - the same
	# value twice otherwise). systemd hands them over from /etc/valuescan/caddy.secret.env
	# (root only); they are never written into this file. A request without it is
	# refused here, before the API or the executor: so their own checks (the API
	# requires the secret on every route but /api/health, the executor on every route
	# but /api/copy/v1/health) are never the only ones, and nobody but the edge can
	# set the X-Forwarded-For and X-Viewer-Country they rely on. Two lines for one
	# field are OR-ed. (One line with two values is not valid Caddyfile: "malformed
	# header matcher". Checked on the instance with Caddy 2.11.6: either value
	# passes; a wrong value, none, or both joined by a comma get the 403.)
	@edge {
		header X-Origin-Verify {$VALUESCAN_ORIGIN_SECRET_1}
		header X-Origin-Verify {$VALUESCAN_ORIGIN_SECRET_2}
	}

	# THE ONE PATH WITHOUT THE SECRET: the live liquidation heatmap's WebSocket
	# (apps/server/src/routes/liqWs.ts). Browsers open it here directly - Vercel's
	# functions hold no socket - so it cannot carry the secret. It is read-only public
	# data; the API checks the site Origin, allows one subscription per connection and
	# a dozen connections per address. That address is the viewer's own: whatever
	# X-Forwarded-For it sent is replaced (trusted_proxies above would keep it, and
	# a client could then choose its own limit key).
	@liqws path /ws/liq
	handle @liqws {
		reverse_proxy 127.0.0.1:8797 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Viewer-Country
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# The beta API's socket (beta.valuedesk.so, deploy/vercel/beta.settings): the same, to
	# the beta API (valuescan-api-beta.service), which serves it as /ws/liq.
	@liqwsbeta path /ws/liq-beta
	handle @liqwsbeta {
		rewrite * /ws/liq
		reverse_proxy 127.0.0.1:8798 {
			header_up X-Forwarded-For {remote_host}
			header_up -X-Viewer-Country
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	handle @edge {
		# Past the gate, by path. Nested handle blocks are mutually exclusive like
		# the outer ones: the first that matches is the only one that runs.
		# The VIP executor (owner 2026-11-09 full VIP migration): AWS Tokyo, behind its own
		# Caddy with the same origin-secret gate. The browser reads /api/copy-vip/v1/* after a
		# wallet moved there (web copy/executor.ts VIP_BASE); the path goes on as /api/copy/v1/*.
		handle /api/copy-vip/* {
			uri replace /api/copy-vip/ /api/copy/ 1
			reverse_proxy https://54-249-40-203.sslip.io {
				header_up Host {upstream_hostport}
				lb_try_duration 20s
				lb_try_interval 250ms
			}
		}

		# The copy executor (apps/executor): every path it serves is under
		# /api/copy/v1/. Caddy's path matcher ignores case; the edge forwards paths
		# exactly, and the executor answers 404 for a path it does not know.
		handle /api/copy/* {
			# Where the executor runs: here (127.0.0.1:8799), or a server of its own
			# (bootstrap.sh EXECUTOR_UPSTREAM=https://<its origin name>, whose Caddy checks
			# the same origin secret, which this request carries on).
			reverse_proxy __EXECUTOR_UPSTREAM__ {
				__EXECUTOR_HOST_LINE__
				# A restart (a release that changes the executor) leaves nothing listening
				# for a few seconds: a request that cannot connect is held and tried again
				# instead of answered 502. Only a failed connect is retried - a request the
				# executor received is never sent twice.
				lb_try_duration 20s
				lb_try_interval 250ms
			}
		}

		# The beta site (beta.valuedesk.so): its Vercel function marks every request
		# (deploy/vercel/api-proxy.cjs, VALUESCAN_CHANNEL=beta), and they go to the beta
		# API (valuescan-api-beta.service), which runs the beta release and refuses all but
		# a listed wallet's token (apps/server/src/beta/gate.ts). The copy executor above is
		# shared: it has no beta.
		@beta header X-VS-Channel beta
		handle @beta {
			reverse_proxy 127.0.0.1:8798 {
				lb_try_duration 15s
				lb_try_interval 250ms
			}
		}

		# Everything else: the index API.
		handle {
			reverse_proxy 127.0.0.1:8797 {
				# Likewise while the API restarts (a few seconds).
				lb_try_duration 15s
				lb_try_interval 250ms
			}
		}
	}

	handle {
		respond 403 {
			close
		}
	}

	header -Server

	# NO access log on purpose. Caddy logs request headers, and every request
	# carries X-Origin-Verify - the origin secret would end up in the journal,
	# next to query strings with wallet addresses (and, on the executor's routes,
	# the followers' read tokens in Authorization). The API logs each request
	# itself (path and client address, never the query string); the executor, at
	# LOG_LEVEL=debug only, method, path and status.
}
