# /etc/caddy/Caddyfile - written by bootstrap.sh from this template
# (__ORIGIN_DOMAIN__ and the email line are filled in). Topology B of
# docs/deploy/SECURITY-HEADERS.md section 2.3:
#
#   viewer -> CloudFront -> Caddy :443 (this file) -> 127.0.0.1:8797 (valuescan-api)
#
# Caddy is here for one job: TLS between CloudFront and the origin, with a
# certificate it obtains and renews by itself.

{
	__ACME_EMAIL_LINE__

	# No admin endpoint. It listens on localhost:2019 by default, and anything on
	# this box - the API process included - could reconfigure Caddy through it.
	# A config change is "systemctl restart caddy".
	admin off

	servers {
		# Keep CloudFront's X-Forwarded-For instead of replacing it with the edge's
		# address: the API rate-limits by viewer (VALUESCAN_TRUST_PROXY=2).
		# Trusting every peer is right ONLY because the security group lets nobody
		# but CloudFront reach port 443.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

__ORIGIN_DOMAIN__ {
	# Port 443 is closed to everyone but CloudFront, so Let's Encrypt cannot
	# validate over TLS-ALPN. It validates over HTTP-01 on port 80, which the
	# security group opens for exactly that (and for the redirect to https).
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	reverse_proxy 127.0.0.1:8797

	header -Server

	# NO access log on purpose. Caddy logs request headers, and every request
	# carries X-Origin-Verify - the origin secret would end up in the journal,
	# next to query strings with wallet addresses. The API logs each request
	# itself (path and client address, never the query string).
}
