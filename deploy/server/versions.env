# Pinned runtime versions for the instance, with the official checksums of their
# Linux tarballs. bootstrap.sh installs exactly these and refuses a download whose
# checksum differs.
#
# To update: change the version AND its checksums together, then re-run the
# bootstrap (deploy/release/bootstrap-instance.sh) and restart the units.
#   Node:  https://nodejs.org/dist/v<version>/SHASUMS256.txt      (sha256)
#   Caddy: https://github.com/caddyserver/caddy/releases/download/v<version>/caddy_<version>_checksums.txt  (sha512)

# Node 24 is the LTS line the project is developed on (node:sqlite, process.loadEnvFile).
NODE_VERSION=24.21.0
NODE_SHA256_ARM64=6ad1325edbdb5649c379b75a237147a666c95d4f9ae8d340fef2d1575d289ad2
NODE_SHA256_X64=fd8e59d5a511510f6a298afb548f18c7d2b1be404d8b4a27d94fbe49f56cb2d6

# Caddy terminates TLS for the origin name (CloudFront -> Caddy -> the API on loopback).
CADDY_VERSION=2.11.6
CADDY_SHA512_ARM64=bd228ea44b6b95720a0c2d7b62886e99cb4a0b05356fe6e058c4a155618c913377b18e686839ae7fcc6c2c05aea2d549fa91f25aa3ef8d43cdead117259577ed
CADDY_SHA512_AMD64=422771007d505ea97efd1177a4905b2c1a471cd426668f2ace3bcda3d8e30b11f9b1610bfb02c6ad60f2a795f56124f2f5eec6409c17d5a0dd4c21a11375fb94
