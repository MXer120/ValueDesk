# /etc/valuescan/api-beta.env (root 0640, group valuescan): the beta API's own settings, read after
# api.env, api.secret.env, api.local.env and alert.env (deploy/server/units/valuescan-api-beta.service),
# so each line here wins over the main API's.

PORT=8798
# The beta channel: the beta list's lock (apps/server/src/beta/gate.ts), the beta sign-in, and none of
# the main API's background jobs that write shared state.
VALUESCAN_CHANNEL=beta
VALUESCAN_RELEASES=0
VALUESCAN_STATUS_PROBE=0
VALUESCAN_FEEDBACK_REPLIES=0
VALUESCAN_INDEXER=0
# The beta site is its only origin: the gate takes POSTs and the heatmap socket from it alone.
VALUESCAN_ALLOWED_ORIGINS=https://beta.valuedesk.so
