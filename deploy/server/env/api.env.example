# /etc/valuescan/api.env - environment of valuescan-api.service (hosted mode).
#
# bootstrap.sh writes this file from this template: it fills in __SITE_DOMAIN__ and
# rewrites the file on every run. Put your own changes into
# /etc/valuescan/api.local.env (same format, read after this file, never touched).
#
# No secret belongs here. VALUESCAN_ORIGIN_SECRET is in /etc/valuescan/api.secret.env,
# which bootstrap.sh fills from SSM Parameter Store.
#
# systemd reads this file: KEY=value per line, no quotes needed, no inline comments.
# Reference: docs/deploy/SECURITY-HEADERS.md section 2.1, apps/server/src/hosted.ts.

# --- the switch -----------------------------------------------------------------

# 1 = the public index API: its GET routes and the knowledge folders' (a wallet's own,
# behind its signed sign-in; hosted.ts HOSTED_ROUTES), everything else 404; no
# custody, no WebSocket hub, no local token - whatever else is set.
VALUESCAN_HOSTED=1

# Never start an indexer in this process. valuescan-indexer.service is the one
# writer of the index (docs/INDEXER.md).
VALUESCAN_INDEXER=0

# --- where it listens --------------------------------------------------------------

# Loopback only: Caddy is in front. Never 0.0.0.0, never open 8797 in a security group.
HOST=127.0.0.1
PORT=8797

# --- who is in front ---------------------------------------------------------------

# The site's origin(s), exact, comma-separated. CORS answers only these. The site
# and the API share an origin behind CloudFront, so CORS is not even used; the value
# is set so that a second origin (a staging site) must be added on purpose. It is
# also the list the knowledge folders' POSTs must come from: add every address the
# site is served at (valuedesk: https://valuexplorer.vercel.app too - on Tokyo in
# /etc/valuescan/api.local.env since 2026-10-24).
VALUESCAN_ALLOWED_ORIGINS=https://__SITE_DOMAIN__

# Who may set X-Forwarded-For. 2 = two proxy hops in front of this process:
# Caddy on loopback, then the CloudFront edge; the next address is the viewer.
# Rate limits are keyed on it. Never more hops than there are proxies: every extra
# hop lets a client choose its own rate-limit key. true and * are refused.
VALUESCAN_TRUST_PROXY=2

# --- rate limits, per client (an IPv4 address or an IPv6 /64) per minute --------------

# Every allowed request.
VALUESCAN_RATE_READ_PER_MIN=600
# Requests that can cost upstream calls: leaderboard search (?q=), deep links by
# account id (/api/feed/account), one announcement.
VALUESCAN_RATE_UPSTREAM_PER_MIN=120
# auth-class routes: the knowledge folders' sign-in (the SoPoints relay is not mounted).
VALUESCAN_RATE_AUTH_PER_MIN=20
# auth-class routes, all clients together.
VALUESCAN_RATE_AUTH_GLOBAL_PER_MIN=300
# write-class routes: changes to a wallet's knowledge folders (also limited per wallet below).
VALUESCAN_RATE_WRITE_PER_MIN=120

# --- knowledge folders (apps/server/src/folders, routes/folders.ts) ---------------------
#
# Each wallet's private research folders: notes, tables, chart snapshots, saved news and
# uploaded PDFs, images and text files.
#
# The records (folders.db), the token secret (session.key: never copy it into a release or a
# backup) and backup/ (the database as it was on each of the last 7 nights) are in FOLDERS_DIR -
# by default the folders/ directory next to VALUETRADE_DEVICE_KEY (/var/lib/valuescan/state/folders,
# on the data volume and already writable for this unit).
#
# The FILES are kept there too (files/<wallet>/), on the data volume, and travel through the
# site's /api - the Vercel edge, the origin secret, its geo-blocking, these limits - in 4 MB
# pieces each way, because the Vercel function carries 4.5 MB at most. The data volume is the
# one place that grows: FOLDERS_MAX_TOTAL_GB and FOLDERS_MIN_FREE_GB keep the index's room.
# (Files in S3 instead: FOLDERS_S3_BUCKET, after deploy/aws/folders-storage.sh - an IAM step for
# the owner - and with the bucket's host added to the CSP in the three places. Not used today.)
# The defaults below are the ones in apps/server/src/folders/limits.ts; set only to change.
#FOLDERS_DIR=/var/lib/valuescan/state/folders
#FOLDERS_MAX_FOLDERS=3
#FOLDERS_MAX_ITEMS=50
# One uploaded file, MB (at most 100), and everything one wallet keeps: the owner's numbers.
#FOLDERS_MAX_FILE_MB=25
#FOLDERS_MAX_WALLET_MB=100
# A 25 MB upload is 7 changes (its pieces).
#FOLDERS_WRITES_PER_MIN=60
#FOLDERS_UPLOADS_PER_HOUR=20
# What one wallet, and all wallets together, may fetch per day.
#FOLDERS_DOWNLOAD_MB_PER_DAY=1024
#FOLDERS_DOWNLOAD_GB_PER_DAY=100
# Wallets one client address may sign in per day.
#FOLDERS_SIGNINS_PER_DAY=10
# All wallets together, and the room growth must leave on the volume (the index lives there).
#FOLDERS_MAX_TOTAL_GB=20
#FOLDERS_MIN_FREE_GB=10
# A wallet not signed in for this many days is deleted with everything in it (0 = never;
# otherwise at least 30). The privacy policy names this period.
#FOLDERS_RETENTION_DAYS=365

# --- the index -----------------------------------------------------------------------

# The file valuescan-indexer.service writes. Same path in indexer.env.
VALUESCAN_INDEX_DB=/var/lib/valuescan/index/valuescan-index.db

# Not a key on a hosted server (custody is off): the server keeps its small state
# files (last-good cache) in this file's directory, which must be writable.
VALUETRADE_DEVICE_KEY=/var/lib/valuescan/state/device.key

# --- network and trading switch --------------------------------------------------------

# 0 = SoDEX mainnet, 1 = testnet. /api/health reports it and the web follows it.
SODEX_TESTNET=0

# What /api/health reports as mainnetWritesAllowed. The web can only be switched
# OFF by it: set 0 and restart valuescan-api to turn trading off for every visitor
# of this deployment (an emergency brake; a build made with
# VITE_ALLOW_MAINNET_TRADING=1 ignores it).
VALUETRADE_ALLOW_MAINNET=1

# --- logging -----------------------------------------------------------------------------

# pino level: fatal, error, warn, info, debug, trace. Request logs carry the path
# (never the query string) and the client address; journald keeps them 14 days.
LOG_LEVEL=info

# --- this process's own upstream budgets -------------------------------------------------
#
# The API reads the index file read-only (apps/server/src/indexer/reader.ts) and
# what it still asks the venues for does not grow with the number of visitors
# (apps/server/test/publicBudgets.test.ts): positioning is answered from the index,
# the whale feeds from one buffer every visitor shares (bounded by the clock, not
# by who asks), and Explore, the screener and the podium curves from shared caches.
# It shares the instance's ONE address with the indexer, and every venue limits
# per address: keep the two processes' shares inside each limit.

# Hyperliquid /info: 1,200 weight a minute per address. The indexer's lanes take
# 500 + 200 (indexer.env). A process that only serves the API (VALUESCAN_HOSTED=1
# or VALUESCAN_INDEXER=0) defaults to 200 (src/valuescan/hyperliquid/info.ts
# HL_WEIGHT_API_ONLY), which keeps the address under 1,200. Set it only to change that.
#VALUESCAN_HL_WEIGHT_PER_MIN=200

# Lighter: 60 requests a minute per address; the indexer takes 30. Default 20.
#VALUESCAN_LIGHTER_PER_MIN=20
# Arcus: 1,500 weight a minute per address; the indexer takes 450. Default 300.
#VALUESCAN_ARCUS_WEIGHT=300

# --- builder fee tiers (docs/BUILDER-TIERS.md) ----------------------------------------
#
# Per-wallet builder fees: this process signs the fee a wallet owes
# (/api/vs/builder/terms) and reads from SoDEX what the wallet paid. Off while
# builder-tiers.json does not exist - then the app charges the fees of its build.
# The files live in the directory of VALUETRADE_DEVICE_KEY above, which only this
# user can read; create them with apps/server/tools/builderTiers.ts (DEPLOY.md,
# "Builder fee tiers"). No secret belongs in this file.
#
# The configuration (re-read when it changes) and the Ed25519 signing key. The key
# is never part of a release or a backup; its public half goes into the web build
# as VITE_BUILDER_TERMS_KEYS.
#VALUESCAN_BUILDER_TIERS_FILE=/var/lib/valuescan/state/builder-tiers.json

# --- SoSoValue news (Explore) --------------------------------------------------------------
#
# The key for openapi.sosovalue.com. It belongs in /etc/valuescan/api.local.env,
# which this file does not overwrite, and never in a release. Make that file root's,
# mode 0600 (systemd reads it as root): the group valuescan includes the copy
# executor's user, which has no business with this key. Absent: /api/vs/news
# answers not_available and Explore says the feed is not available.
# deploy/release/set-sosovalue-key.sh sets it there (and in a local .env), asking for it.
#SOSOVALUE_API_KEY=
#
# --- The Live Feed's news channels (YouTube Data API v3) -------------------------------------
#
# A key from a Google Cloud project with the YouTube Data API v3 enabled (free quota: 10,000
# units a day). The server finds which video a channel has on air with it - never by reading
# youtube.com's pages, which YouTube's terms forbid. About 3 units per channel per five minutes
# while someone watches, plus at most one 100-unit search per channel an hour. Same place and
# file mode as the SoSoValue key. Absent: /api/vs/live answers not_available and the widget's
# channels cannot be found (pasted links still play).
#YOUTUBE_API_KEY=
#VALUESCAN_BUILDER_TERMS_KEY_FILE=/var/lib/valuescan/state/builder-terms.key
# What has been counted. Written by this process only (the indexer never opens it).
#VALUESCAN_BUILDER_DB=/var/lib/valuescan/state/builder.db
#
# SoDEX's /trades and /orders/history share ONE limit of about 4 requests a minute
# per address, for this whole instance: reads of a wallet's fills, per minute.
# Default 1; a higher value is cut to 2. The indexer's /trades drip must stay off
# (indexer.env) while this runs.
#VALUESCAN_BUILDER_VERIFY_PER_MIN=1
# Approval reads (GET /user/{a}/builders) for wallets that left a hint. Default 10, at most 30.
#VALUESCAN_BUILDER_APPROVALS_PER_MIN=10
# Lookups of an order's signed request on SoDEX's public explorer: which builder it
# names, and which key signed it. Default 3, at most 6; any answer that is not a 200
# pauses them. 0 switches them off - and with them all counting.
#VALUESCAN_BUILDER_EXPLORER_PER_MIN=3
#VALUESCAN_BUILDER_EXPLORER=https://clobscan-mainnet.sodex.dev
# How far back a wallet's fills are read when it is first verified (days, 0..90). Default 7.
#VALUESCAN_BUILDER_LOOKBACK_DAYS=7

# --- optional overrides (defaults are right for production) --------------------------------

# 0 = the screener does not enrich rows with per-trader reads.
#VALUESCAN_SCREENER_ENRICH=1
# ValueChain RPC for the deep-link fallback (/api/feed/account). Default: the public endpoint.
#VALUECHAIN_RPC=https://rpc.valuechain.xyz
