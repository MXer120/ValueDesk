# /etc/valuescan/indexer.env - environment of valuescan-indexer.service.
#
# bootstrap.sh writes this file from this template and rewrites it on every run.
# Put your own changes into /etc/valuescan/indexer.local.env (same format, read
# after this file, never touched). No secret belongs here: the indexer reads public
# data only.
#
# systemd reads this file: KEY=value per line, no quotes needed, no inline comments.
# Reference: docs/INDEXER.md ("Budgets"), apps/server/src/indexer/engine.ts.

# --- the index -----------------------------------------------------------------------

# The one file this process writes (SQLite, WAL). Exactly ONE indexer per file.
# Same path in api.env.
VALUESCAN_INDEX_DB=/var/lib/valuescan/index/valuescan-index.db

# Directory for small state files (this file itself is never created on a server
# without custody). Must be writable.
VALUETRADE_DEVICE_KEY=/var/lib/valuescan/state/device.key

# 0 = SoDEX mainnet, 1 = testnet. Same value as in api.env.
SODEX_TESTNET=0

# Whole UTC days of raw fills and closes kept (docs/INDEXER.md, "Storage"). Older
# days live on as one summed row per trader and day, so every window still reads,
# but below 91 the 90d window starts at 00:00 UTC of its first day (below 31 the
# 30d one too). The code's default is 100. 31 keeps the index at an estimated
# 33-44 GB (about 3,300 wallets, 4.5 million fills a day; at 100 days, by the
# same estimate, roughly three times that): what the data volume of the test
# instance is sized for (docs/deploy/EC2-VERCEL.md, "Sizing"). Raise it together
# with the volume.
#
# NOTHING IS DELETED FOR BEING OLD WITHOUT THE OWNER'S WORD (owner, 2026-10-28; apps/server/src/retention.ts):
# the raw fills past RETAIN_DAYS stay unless VALUESCAN_PRUNE names 'fills', and so do the cohort series,
# the heatmap history and its change log, the trader stats and the activity unless it names theirs.
# A comma list of fills, activity, trader-stats, cohort-history, liq-history, liq-log, status, builder,
# client-errors, or all. Unset keeps everything: the disk is the limit (the health check warns at
# HEALTH_DISK_PCT), and the owner decides what may go.
#VALUESCAN_PRUNE=
VALUESCAN_INDEX_RETAIN_DAYS=31

# --- budgets, per address ---------------------------------------------------------------
#
# The instance has ONE address and the API process shares it (api.env). The values
# below are the code's defaults, written out so they can be seen and changed here.

# Hyperliquid /info weight a minute for the boards' fill reads (HL allows 1,200).
VALUESCAN_INDEX_HL_WEIGHT=500
# Hyperliquid /info weight a minute for the cohorts' position reads and the holders'
# portfolio PnL reads (400 since 2026-10-24: with the boards' 500 and the API's 200,
# 1,100 of HL's 1,200).
VALUESCAN_INDEX_HL_COHORT=400
# Hyperliquid /info weight a minute for a cohort history rebuild (funding history
# for hours the indexer did not record). Lent by the boards' share above while a
# rebuild reads, so the total stays the same; 0 extra when there is nothing to rebuild.
#VALUESCAN_INDEX_HL_REBUILD=200
# Ceiling of this process's Hyperliquid client (default 1,000). The two lanes
# above rest so that their average stays at their share; the ceiling leaves room
# for the streams' market reads and for weight HL charges after a large answer.
# The API process defaults to 200 (api.env), so the address averages under 1,200.
#VALUESCAN_HL_WEIGHT_PER_MIN=1000

# SoDEX positions/history requests a minute (closed positions of board members).
VALUESCAN_INDEX_SODEX_CLOSES=6
# SoDEX gateway requests a minute for the cohorts' position reads.
VALUESCAN_INDEX_SODEX_COHORT=20
# SoDEX data host requests a minute (rankings, rank lookups, charts).
VALUESCAN_INDEX_SODEX_DATA=60

# SoDEX /trades backfill: OFF unless a rate is set. Cloudflare allows about 4
# requests a minute for /trades and /orders/history TOGETHER per address and then
# blocks the whole address (error 1015). The code never goes above 2 a minute.
# Leave it off; the trade stream records every fill of a tracked trader anyway.
#VALUESCAN_INDEX_SODEX_TRADES=
# How far back /trades would reach for a SoDEX board member, in days.
#VALUESCAN_INDEX_SODEX_TRADES_DAYS=30

# Lighter requests a minute (Lighter allows 60; the API process keeps 20).
VALUESCAN_INDEX_LIGHTER=30
# Arcus weight a minute (Arcus allows 1,500; the API process keeps 300).
VALUESCAN_INDEX_ARCUS=450

# --- switches --------------------------------------------------------------------------------

# 0 = no live trade streams (REST only). Leave on.
VALUESCAN_INDEX_STREAMS=1
# 0 = no cohort tracking. Leave on.
VALUESCAN_INDEX_COHORTS=1

# --- optional ---------------------------------------------------------------------------------

# V8's heap limit in MiB, if the indexer ever needs more than the default
# (the unit caps the whole process at 1.8 GB on a 4 GiB instance; keep the heap
# well under that - SQLite's cache and the page cache count against it too).
#NODE_OPTIONS=--max-old-space-size=1200

# 0: the indexer's HTTP back on its main thread, as before 2026-11-06 (src/indexer/fetchThread.ts).
#VALUESCAN_INDEX_FETCH_THREAD=0
