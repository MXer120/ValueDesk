# /etc/valuescan/executor.env - environment of valuescan-executor.service (the
# hosted copy executor, apps/executor).
#
# bootstrap.sh writes this file from this template: it fills in __SITE_DOMAIN__ and
# __EXECUTOR_LOCATION__ and rewrites the file on every run. Put your own changes
# into /etc/valuescan/executor.local.env (same format, read after this file, never
# touched).
#
# No secret belongs here. EXECUTOR_ORIGIN_SECRET (and _2) are in
# /etc/valuescan/executor.secret.env (root only), which bootstrap.sh writes with the
# same values Caddy's gate accepts (caddy.secret.env).
#
# systemd reads this file: KEY=value per line, no quotes needed, no inline comments.
# Reference: apps/executor/src/config.ts, apps/executor/README.md.

# --- the switch -----------------------------------------------------------------

# hosted = ValueDesk's own executor behind the edge: many followers, the origin
# secret required, the viewer's address and country taken from the edge's headers.
EXECUTOR_KIND=hosted

# --- where it listens --------------------------------------------------------------

# Loopback only: Caddy is in front (/api/copy/* -> here). Never 0.0.0.0, never open
# 8799 in a security group.
HOST=127.0.0.1
PORT=8799

# --- its data ------------------------------------------------------------------------

# The database (executor.db: copies, activity, the followers' sealed keys, accepted
# terms, every signed instruction), the key-encryption key (kek) and the session
# secret (session.key). Owned by valuescan-executor, 0700 (bootstrap.sh). The nightly
# backup copies executor.db only (valuescan-executor-backup.service); kek and
# session.key stay on the data volume and in its EBS snapshots.
EXECUTOR_DATA_DIR=/var/lib/valuescan/executor

# --- who is in front -------------------------------------------------------------------

# 1 = the first X-Forwarded-For address is the viewer (Caddy keeps the edge's, as
# for the API) and X-Viewer-Country is the edge's (the Vercel function sets it from
# x-vercel-ip-country and never passes a client's own). Safe ONLY because Caddy
# refuses every request without the origin secret.
EXECUTOR_TRUST_EDGE=1

# The site's origin(s), exact, comma-separated: CORS answers only these. Add every
# address the site is served at (valuedesk: https://valuexplorer.vercel.app too).
EXECUTOR_ALLOWED_ORIGINS=https://__SITE_DOMAIN__

# What followers are shown as the place their copies run.
EXECUTOR_LOCATION=__EXECUTOR_LOCATION__

# --- network and fees ----------------------------------------------------------------------

# mainnet or testnet. Same network as api.env (SODEX_TESTNET=0 there).
SODEX_NETWORK=mainnet

# The builder copied orders carry: the web build's VITE_BUILDER_ID
# (deploy/release/web.env). bootstrap-instance.sh refuses to run when the two differ.
EXECUTOR_BUILDER_ID=234812

# The builder ledger the copy fee tier is read from (written by the API,
# api.env VALUESCAN_BUILDER_DB). Opened read-only. Absent: every follower's volume
# counts as unknown.
EXECUTOR_BUILDER_DB=/var/lib/valuescan/state/builder.db

# When the API (and so the ledger) runs on ANOTHER server - production since 2026-10-25: the
# API on server 1, this executor on server 2 - the ledger file is not here, and every
# follower would pay the first (dearest) copy fee step. Then read the volume from the API
# instead: its GET /api/vs/builder/volume, with EXECUTOR_BUILDER_TOKEN (in
# executor.secret.env) set to the API's VALUESCAN_INTERNAL_TOKEN (api.secret.env). The
# executor's origin secret is sent too, for the API server's gate. Set, it wins over the file.
#EXECUTOR_BUILDER_URL=https://<api server>/api/vs/builder/volume

# --- logging ------------------------------------------------------------------------------

# debug, info, warn, error. debug logs every request (method, path, status).
LOG_LEVEL=info

# --- optional overrides (defaults are right for production) --------------------------------

# 0 = closed to new followers; running copies continue.
#EXECUTOR_OPEN=1
# The longest key lifetime a follower may register, in days (default 180, at most 180: the copy terms
# promise it). A key registered on SoDEX for longer is not used.
#EXECUTOR_KEY_TTL_DAYS=180
# Copies per wallet (default 10, at most 50).
#EXECUTOR_MAX_COPIES=10
# Days of copy activity kept (default 365).
#EXECUTOR_ACTIVITY_DAYS=365
# Algo orders per wallet running at once (default 20, at most 100).
#EXECUTOR_MAX_ALGOS=20
# 1 = real (non-practice) algo orders may start. Off until the owner switches them on;
# practice runs always can. Turning it off again stops new ones only (running ones go on).
#EXECUTOR_LIVE_ALGOS=0

# --- its own address ----------------------------------------------------------------

# Every request and socket to SoDEX and Hyperliquid leaves from this local IP. SoDEX's
# Cloudflare bans an IP that asks too much on every path for up to five minutes; with
# an address of its own, a ban the indexer earns cannot stop the copies. Set it in
# executor.local.env to the instance's SECONDARY private IP, which carries an Elastic
# IP of its own (provision.sh executor-ip; docs/deploy/EC2-VERCEL.md section 13).
# Empty: the instance's default route, shared with the indexer and the API.
#EXECUTOR_LOCAL_ADDRESS=
