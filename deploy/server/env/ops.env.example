# /etc/valuescan/ops.env - settings of the operations scripts in /opt/valuescan/bin
# (release.sh, backup.sh, restore.sh, healthcheck.mjs). Also read by the executor's
# backup unit (valuescan-executor-backup.service): nothing in it is secret.
#
# bootstrap.sh writes this file from this template: it fills in the __...__ values
# and rewrites the file on every run. Put your own changes into
# /etc/valuescan/ops.local.env (never touched). No secret belongs here.
#
# systemd and the scripts both read this file: KEY=value per line, no quotes, no
# inline comments.

# Region of the instance and of the ops bucket.
AWS_REGION=__AWS_REGION__
AWS_DEFAULT_REGION=__AWS_REGION__

# The private ops bucket (network.yaml output OpsBucketName):
#   releases/server/   server tarballs      backups/   index backups
#   releases/web/      web builds           seed/      a snapshot to start from
# EMPTY on an instance without an instance role (the EC2 test environment,
# docs/deploy/EC2-VERCEL.md): releases then arrive over SSH, and backups stay on
# the data volume (BACKUP_DIR), which EBS snapshots of that volume carry off the box.
OPS_BUCKET=__OPS_BUCKET__

# The index database and where a backup is staged before it is uploaded.
VALUESCAN_INDEX_DB=/var/lib/valuescan/index/valuescan-index.db
BACKUP_STAGING_DIR=/var/lib/valuescan/backup
# 1 = keep the newest staged copy on the data volume (a restore without a download;
# costs the size of the database). 0 = delete it after the upload.
BACKUP_KEEP_LOCAL=0
# Without an ops bucket: where the compressed backups are kept, and how many
# (each is about a third of the index; the oldest beyond this number is removed
# after a new one is complete). Older days are in the EBS snapshots of the volume.
BACKUP_DIR=/var/lib/valuescan/backup/archive
BACKUP_KEEP=1
# zstd level for the upload (3 is fast; the database compresses about 3x).
BACKUP_ZSTD_LEVEL=3

# The copy executor's database, backed up after the index every night by
# valuescan-executor-backup.service (backup.sh --executor, as valuescan-executor).
# Only the database: kek and session.key in its directory are never copied.
EXECUTOR_DB=/var/lib/valuescan/executor/executor.db
# Its staging copy and, without an ops bucket, <this>/archive with the compressed
# backups (0700, owned by valuescan-executor). With an ops bucket:
# s3://<ops bucket>/backups/valuescan-executor-<time>.db.zst.
EXECUTOR_BACKUP_DIR=/var/lib/valuescan/backup/executor
# How many executor backups the data volume keeps (each is small: the database
# holds copies, activity and signed instructions, no market data).
EXECUTOR_BACKUP_KEEP=7

# The API on loopback, as the health check reaches it.
API_URL=http://127.0.0.1:8797
# The copy executor on loopback (the health check asks /api/copy/v1/health, and
# release.sh waits for it after a restart). Empty: the health check skips it.
EXECUTOR_URL=http://127.0.0.1:8799

# The origin name Caddy serves (the health check reads its certificate's expiry).
ORIGIN_DOMAIN=__ORIGIN_DOMAIN__

# SNS topic for health alerts (compute.yaml output AlertTopicArn). Empty = log only
# (always so without an instance role: watch /api/health from outside instead).
ALERT_TOPIC_ARN=__ALERT_TOPIC_ARN__

# Health thresholds.
# The indexer publishes its status every 30 s; older than this many seconds is "stale".
HEALTH_INDEXER_STALE_S=180
# The boards are rebuilt about once a minute; older than this many seconds is "stale".
HEALTH_BOARD_STALE_S=3600
# Alert when the data volume is fuller than this, in percent.
HEALTH_DISK_PCT=80

# How many installed releases release.sh keeps under /opt/valuescan/releases.
RELEASES_KEEP=3
