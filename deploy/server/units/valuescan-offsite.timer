# Installed to /etc/systemd/system by deploy/server/bootstrap.sh.
#
# Every 15 minutes: backup-offsite.sh decides per set whether it is its turn (a changed
# ledger or executor database goes within 15 minutes, everything at least daily, the
# heavy sets weekly in the quiet hours). Does nothing without /etc/valuescan/offsite.env.

[Unit]
Description=Valuescan off-server backup, every 15 minutes

[Timer]
OnBootSec=5min
OnCalendar=*:07/15
RandomizedDelaySec=60
Persistent=true

[Install]
WantedBy=timers.target
