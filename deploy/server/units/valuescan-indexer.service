# Installed to /etc/systemd/system by deploy/server/bootstrap.sh.
#
# The indexer is the ONLY writer of the index database (docs/INDEXER.md: exactly
# one indexer per database file). It holds the venues' trade streams; every
# restart costs the Lighter stream 3.5-8 minutes of re-subscribing and leaves a
# gap the boards have to re-read, so restart it only when its code changed.

[Unit]
Description=Valuescan indexer (the only writer of the index database)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/valuescan
# No release installed yet: nothing to run (the first release starts it).
ConditionPathExists=/opt/valuescan/current/apps/server/src/indexer/main.ts
# Keep trying: an upstream outage must not leave the indexer down for good.
StartLimitIntervalSec=0

[Service]
Type=simple
User=valuescan
Group=valuescan
WorkingDirectory=/opt/valuescan/current/apps/server
EnvironmentFile=/etc/valuescan/indexer.env
EnvironmentFile=-/etc/valuescan/indexer.local.env
# node:sqlite still prints an ExperimentalWarning; "--import tsx" runs the
# TypeScript sources directly, in this one process (no wrapper to forward signals).
# The heap is set, not left to Node: it derives one from MemoryMax, and at the
# old 1800M that was ~690 MB - the indexer outgrew it and crashed every 16-26
# minutes, before most board builds could finish (Tokyo, 2026-10-23).
ExecStart=/opt/node/current/bin/node --max-old-space-size=1536 --disable-warning=ExperimentalWarning --import tsx src/indexer/main.ts
Restart=always
# Slow restarts: a crash loop must not hammer the exchanges with reconnects.
RestartSec=30
# SIGTERM: the indexer flushes, publishes its status and closes the database.
KillSignal=SIGTERM
TimeoutStopSec=45
LimitNOFILE=65536
# No core file: writing one of a 1.5 GB heap held the restart back 5 minutes,
# and systemd-coredump discarded it as too large anyway.
LimitCORE=0
# Sized for a 4 GiB instance (t4g.medium): a runaway is stopped inside this unit
# before it can take the box (and sshd / the SSM agent) down.
# THE PAGE CACHE COUNTS HERE: the database pages this unit reads are charged to
# it, and above MemoryHigh the kernel reclaims them first. The indexer's own
# memory is ~0.7 GB; the rest of MemoryHigh is how much of the database stays
# cached. At 1400M that was ~0.7 GB of a 19 GB file, and a board build took
# 11-25 minutes waiting on the disk (Tokyo, 2026-10-23). The API (~0.1 GB) and
# the executor (~0.06 GB) leave this much room. On 8 GiB (t4g.large) 6G / 6.5G:
# a drop-in, `systemctl edit valuescan-indexer`. A running unit takes new limits
# without a restart: systemctl set-property --runtime valuescan-indexer.service ...
MemoryHigh=2600M
MemoryMax=3000M
SyslogIdentifier=valuescan-indexer

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service @pkey
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0027
# The only writable places: the database (with its -wal and -shm) and the state directory.
ReadWritePaths=/var/lib/valuescan/index /var/lib/valuescan/state
# MemoryDenyWriteExecute is deliberately NOT set: V8's JIT needs writable+executable memory.

[Install]
WantedBy=multi-user.target
