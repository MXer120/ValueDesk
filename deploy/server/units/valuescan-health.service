# Installed to /etc/systemd/system by deploy/server/bootstrap.sh.
#
# One pass of deploy/server/bin/healthcheck.mjs: /api/health, the hosted
# lock-down, an index read through the gate, the indexer's own status
# (/api/vs/index/health), the copy executor (/api/copy/v1/health on 127.0.0.1:8799),
# disk space, the last backup, the certificate. It logs one line; on a change of
# state it publishes to the alert topic, if one is set.

[Unit]
Description=Valuescan health check
After=network-online.target
RequiresMountsFor=/var/lib/valuescan

[Service]
Type=oneshot
User=valuescan
Group=valuescan
EnvironmentFile=/etc/valuescan/ops.env
EnvironmentFile=-/etc/valuescan/ops.local.env
# The board read needs the origin secret, like every request but /api/health and
# the on-instance health route (the check sends the first value of the list).
EnvironmentFile=-/etc/valuescan/api.secret.env
Environment=HOME=/var/lib/valuescan/state
ExecStart=/opt/node/current/bin/node --disable-warning=ExperimentalWarning /opt/valuescan/bin/healthcheck.mjs
# A failed check is a result, not a broken unit: the script decides what to alert.
SuccessExitStatus=1
TimeoutStartSec=45
SyslogIdentifier=valuescan-health

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# Only its own state (health-state.json). The index is never opened: the indexer's
# status comes from /api/vs/index/health, an on-instance route of the API.
ReadWritePaths=/var/lib/valuescan/state
