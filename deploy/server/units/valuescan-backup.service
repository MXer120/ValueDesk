# Installed to /etc/systemd/system by deploy/server/bootstrap.sh.
#
# One consistent copy of the index database to S3, or to the data volume on an
# instance without an ops bucket (deploy/server/bin/backup.sh).
# The copy is a snapshot of the WAL shipper's replica (valuescan-walship.service,
# wal-ship.mjs): the live file is not read. Without WALSHIP_DIR backup.sh refuses
# the index unless BACKUP_ALLOW_LIVE_COPY=1 (the old one-read-transaction copy). Retention in S3 is the bucket's lifecycle rule (this
# unit cannot delete a backup there); on the data volume backup.sh keeps BACKUP_KEEP.
#
# The copy executor's database is part of the same nightly backup: this unit wants
# valuescan-executor-backup.service, which runs after it as the executor's own user
# (the valuescan user cannot read the executor's directory).

[Unit]
Description=Valuescan index backup (to S3, or to the data volume)
After=network-online.target
Wants=network-online.target valuescan-executor-backup.service
RequiresMountsFor=/var/lib/valuescan
ConditionPathExists=/var/lib/valuescan/index/valuescan-index.db

[Service]
Type=oneshot
User=valuescan
Group=valuescan
EnvironmentFile=/etc/valuescan/ops.env
EnvironmentFile=-/etc/valuescan/ops.local.env
Environment=HOME=/var/lib/valuescan/state
ExecStart=/opt/valuescan/bin/backup.sh
TimeoutStartSec=2h
SyslogIdentifier=valuescan-backup

# Stay out of the indexer's way: its event loop stalls when the disk does.
Nice=10
CPUWeight=20
IOWeight=20
IOReadBandwidthMax=/var/lib/valuescan 40M
IOWriteBandwidthMax=/var/lib/valuescan 40M
# The check and the compression read the whole 50 GB snapshot: the page cache that fills is charged to this unit and
# reclaimed here first, so it does not push the live index out of memory (it did, 2026-11-08). The check's own SQLite
# cache is 4 GB (backup-index.mjs).
MemoryHigh=6G
MemoryMax=8G

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# Reads the database (and its -shm, which a WAL reader maps read-write); writes the staging copy.
ReadWritePaths=/var/lib/valuescan/index /var/lib/valuescan/backup /var/lib/valuescan/state
