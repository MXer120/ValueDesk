# Installed to /etc/systemd/system by deploy/server/bootstrap.sh. NOT enabled by bootstrap: the owner enables it
# (docs/deploy/BACKUPS.md, "The index: WAL shipping").
#
# The index's WAL shipper (deploy/server/bin/wal-ship.mjs): a replica of the index that follows the live file by
# seconds, from the WAL, holding only read transactions of ~10 ms on the live file. The nightly backup
# (valuescan-backup.service -> backup.sh) takes its snapshot from the replica, never from the live file.
#
# Restarting it is cheap while the WAL still holds the frame it ended on (it resumes); after a longer stop the WAL
# has started over and it makes ONE new base copy of the live file at WALSHIP_BASE_MB_S (25 MB/s: ~35 min for 50 GB),
# still with short read transactions only. So: do not restart it with every release, only when wal-ship.mjs changed.

[Unit]
Description=Valuescan index WAL shipper (replica for the backups)
After=valuescan-indexer.service
RequiresMountsFor=/var/lib/valuescan
ConditionPathExists=/var/lib/valuescan/index/valuescan-index.db

[Service]
Type=simple
User=valuescan
Group=valuescan
EnvironmentFile=/etc/valuescan/ops.env
EnvironmentFile=-/etc/valuescan/ops.local.env
Environment=HOME=/var/lib/valuescan/state
ExecStart=/opt/node/current/bin/node --disable-warning=ExperimentalWarning /opt/valuescan/bin/wal-ship.mjs run --db ${VALUESCAN_INDEX_DB} --dir ${WALSHIP_DIR}
# SIGTERM: it lets go of its read transactions at once, fsyncs the replica and records where it is.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=30
SyslogIdentifier=valuescan-walship

# Its own CPU and memory, so the indexer's never suffer. Not Nice/CPUWeight-starved: a read transaction is held while
# the main loop runs, so the loop must get the CPU when it asks (it uses ~1% of a core).
CPUQuota=100%
# Page cache it causes (the base copy, the replica, snapshots) is charged here and reclaimed here first, so the live
# index stays in memory. MemoryHigh throttles and reclaims; MemoryMax is the hard stop.
MemoryHigh=1G
MemoryMax=2G
# Disk: the copies pace themselves (WALSHIP_BASE_MB_S, WALSHIP_SNAP_MB_S); this is the backstop above them. WAL reads
# come from the page cache (just written by the indexer) and are not throttled.
IOWeight=20
IOReadBandwidthMax=/var/lib/valuescan 80M
IOWriteBandwidthMax=/var/lib/valuescan 80M

# --- hardening ---
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
# The index directory: read-only use of the database, but a WAL reader maps the -shm read-write.
# The backup directory: the replica, its state, and the snapshots backup.sh asks for (in the staging directory).
ReadWritePaths=/var/lib/valuescan/index /var/lib/valuescan/backup

[Install]
WantedBy=multi-user.target
