# Installed to /etc/systemd/system by deploy/server/bootstrap.sh.
#
# Caddy terminates TLS for the origin name: the edge (CloudFront, or the Vercel
# function) -> Caddy (443) -> the copy executor on 127.0.0.1:8799 for /api/copy/*,
# the API on 127.0.0.1:8797 for everything else, and passes on only what carries
# the origin secret. It obtains and renews its own certificate (Let's Encrypt,
# HTTP-01 on port 80). Config: /etc/caddy/Caddyfile.

[Unit]
Description=Caddy (TLS for the Valuescan origin)
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=notify
User=caddy
Group=caddy
Environment=XDG_DATA_HOME=/var/lib/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/caddy/config
# VALUESCAN_ORIGIN_SECRET_1 and _2 for the Caddyfile's gate. Root-only (0600):
# systemd reads it before it drops to the caddy user; bootstrap.sh writes it.
EnvironmentFile=/etc/valuescan/caddy.secret.env
ExecStartPre=/usr/local/bin/caddy validate --config /etc/caddy/Caddyfile
ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
# The admin endpoint is off (Caddyfile): a config change is a restart.
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
LimitNOFILE=1048576
SyslogIdentifier=caddy

# --- hardening ---
# Ports 80 and 443 are the only privilege it needs.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0027
# Certificates and the ACME account.
ReadWritePaths=/var/lib/caddy

[Install]
WantedBy=multi-user.target
