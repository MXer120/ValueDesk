# /etc/valuescan/indexer.local.env on server 1 (0640 root:valuescan). Never touched by
# bootstrap.sh. Names only. On 2026-10-27 these were TEMPORARY settings while the
# Hyperliquid archive's holders are read (the notes of that day: weight 200 instead of
# 500 for the boards, cohort 700 instead of 400, 96 parallel reads); the file before
# that change is indexer.local.env.bak-20261027 next to it. Put the boards back to the
# defaults (delete the three lines) once the archive holders are read.
VALUESCAN_INDEX_HLC_CONCURRENCY=
VALUESCAN_INDEX_HL_WEIGHT=
VALUESCAN_INDEX_HL_COHORT=
