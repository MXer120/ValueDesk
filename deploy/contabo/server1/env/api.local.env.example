# /etc/valuescan/api.local.env on server 1 - ROOT ONLY (0600 root:root; systemd reads it
# for the API). Never touched by bootstrap.sh. The names only - the values are on the
# server (and the keys with the owner): deploy/release/set-sosovalue-key.sh and
# set-youtube-key.sh write the two keys.
#
# SoSoValue API key (news, ETF flows, indicators). A SECRET.
SOSOVALUE_API_KEY=
# YouTube Data API key (the Fed channel, the live streams). A SECRET.
YOUTUBE_API_KEY=
# BLS Public Data API key (indicator history; optional: 25 requests a day without it). A SECRET.
BLS_API_KEY=
# BEA API key (PCE and GDP history; those indicators are not available without it). A SECRET.
BEA_API_KEY=
# Every address the site is served at, comma-separated (api.env has only https://<SITE_DOMAIN>);
# production (2026-10-27): www.valuedesk.so FIRST (the site's own address; a POST from it - feedback,
# error reports, folders - is refused with "origin not allowed" without it), then the others.
VALUESCAN_ALLOWED_ORIGINS=https://www.valuedesk.so,https://valuedesk.so,https://valuedeskapp.vercel.app,https://valuexplorer.vercel.app
