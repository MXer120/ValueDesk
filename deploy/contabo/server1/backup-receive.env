# /etc/vsbackup/receive.env on SERVER 1 - what it RECEIVES from server 2 (backup-receive.sh,
# the forced command of the vsbackup user). Installed by apply-overlay.sh server1
# (root 0644: vsbackup reads it; nothing secret). Everything arriving is encrypted with
# server 2's key, which this server never has.

RECEIVE_DIR=/var/lib/vsbackup
RECEIVE_SETS="executor journal"
# Days kept, by arrival (the newest copy of a set always stays).
RECEIVE_KEEP_DAYS_executor=30
RECEIVE_KEEP_DAYS_journal=400
# Largest single copy, MB.
RECEIVE_MAX_MB_executor=512
RECEIVE_MAX_MB_journal=1024
# All copies together, and what must stay free on this disk (the index lives here).
RECEIVE_MAX_TOTAL_GB=48
RECEIVE_MIN_FREE_GB=40
RECEIVE_STRICT_SETS=""
