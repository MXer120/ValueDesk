# /etc/valuescan/offsite.env on SERVER 1 - what backup-offsite.sh sends, and where.
# Installed by deploy/contabo/apply-overlay.sh server1 (root 0640). Nothing secret: the
# keys are files in /etc/valuescan/offsite/ (offsite-setup.sh sender).

OFFSITE_LABEL=server1
# Server 2, its user vsbackup (whose only command is backup-receive.sh).
OFFSITE_HOST=13.140.77.201
OFFSITE_USER=vsbackup
# api-state and folders when they change (at least daily), the journal daily, the
# index and the HL archive weekly (backup-offsite.sh, "THE SETS").
OFFSITE_SETS="api-state folders journal index hl-archive"
# MB/s on the wire (the weekly index copy: ~4.6 GB, about 8 minutes at 10).
OFFSITE_RATE_MBPS=10
# UTC hours for the daily and weekly sets: after the nightly index backup (03:17 + up to
# 30 minutes), before the European morning.
OFFSITE_HEAVY_HOURS="04 05"
OFFSITE_FORCE_AFTER_H=20
