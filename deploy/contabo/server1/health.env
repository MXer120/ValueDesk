# /etc/valuescan/health.env on SERVER 1 (161.97.154.121, France: the indexer, the API,
# Caddy). Installed by deploy/contabo/apply-overlay.sh server1; read by
# valuescan-health.service after ops.env, so what is here wins. Nothing secret.
# What each setting means: deploy/server/bin/healthcheck.mjs (the header).

# How a Telegram message names this server.
HEALTH_SERVER_NAME=server 1 (France: API + indexer, 161.97.154.121)

# The checks of an API server. No `executor`: the copy executor runs on server 2 and is
# watched there - and from here, as a peer (below).
HEALTH_CHECKS=api,lockdown,index,indexer,disk,backup,tls,units
HEALTH_UNITS=valuescan-indexer.service,valuescan-api.service,caddy.service
# ops.env points EXECUTOR_URL at this server's loopback (release.sh uses it); the
# health check must not: the executor is held here (valuescan-executor.service.d/hold.conf).
EXECUTOR_URL=

# CROSS-WATCH. Server 2's executor through its own Caddy (gated: it gets the origin
# secret, over https only), and the whole public path site -> Vercel -> here -> server 2
# (public: never the secret).
HEALTH_PEERS_GATED=executor@server2=https://13-140-77-201.sslip.io/api/copy/v1/health
HEALTH_PEERS_PUBLIC=site=https://www.valuedesk.so/,site-copy=https://www.valuedesk.so/api/copy/v1/health

# The nightly index backup, and the off-server copy of the API's state (backup-offsite.sh).
HEALTH_BACKUP_MARKERS=/var/lib/valuescan/state/last-backup.json,/var/lib/valuescan/state/offsite-api-state.json
