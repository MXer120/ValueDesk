# /etc/valuescan/bootstrap.env on server 1 (0640 root:root): bootstrap.sh's answers of its
# last run, the defaults of the next. Written BY bootstrap.sh; listed here so a rebuilt
# server gets the same answers (deploy/contabo/README.md, "Rebuilding a server").
# Nothing here is secret: these are public names. ACME_EMAIL is left out (personal data);
# Caddy works without it.
SITE_DOMAIN=valuedeskapp.vercel.app
ORIGIN_DOMAIN=161-97-154-121.sslip.io
OPS_BUCKET=
CONFIG_PREFIX=/valuescan/prod
ALERT_TOPIC_ARN=
ACME_EMAIL=
# One disk: the data stays on the root filesystem.
DATA_DEVICE=none
KEEP_SSHD=1
ORIGIN_SECRET_FILE=/root/.valuescan/origin-secret
# Caddy passes /api/copy/* to the executor on server 2.
EXECUTOR_UPSTREAM=https://13-140-77-201.sslip.io
