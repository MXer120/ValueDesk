# /etc/vsbackup/receive.env on SERVER 2 - what it RECEIVES from server 1 (backup-receive.sh,
# the forced command of the vsbackup user). Installed by apply-overlay.sh server2
# (root 0644: vsbackup reads it; nothing secret). Everything arriving is encrypted with
# server 1's key, which this server never has.

RECEIVE_DIR=/var/lib/vsbackup
RECEIVE_SETS="api-state folders journal index hl-archive"
# Days kept, by arrival. The newest copy of a set always stays - except folders (strict):
# the privacy policy says deleted folder text is gone from every copy within seven days.
# index: 14 days, as the privacy policy says for the index backups.
RECEIVE_KEEP_DAYS_api_state=30
RECEIVE_KEEP_DAYS_folders=7
RECEIVE_KEEP_DAYS_journal=400
RECEIVE_KEEP_DAYS_index=14
RECEIVE_KEEP_DAYS_hl_archive=60
RECEIVE_STRICT_SETS="folders"
# Largest single copy, MB (the index copy is ~4.6 GB; the folders' files may grow - the
# whole set travels each time, so above ~2 GB it needs another way: say so then).
RECEIVE_MAX_MB_api_state=512
RECEIVE_MAX_MB_folders=2048
RECEIVE_MAX_MB_journal=1024
RECEIVE_MAX_MB_index=8192
RECEIVE_MAX_MB_hl_archive=2048
# All copies together, and what must stay free (a 100 GB disk; the executor needs little).
RECEIVE_MAX_TOTAL_GB=60
RECEIVE_MIN_FREE_GB=20
