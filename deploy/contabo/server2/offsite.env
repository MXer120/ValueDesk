# /etc/valuescan/offsite.env on SERVER 2 - what backup-offsite.sh sends, and where.
# Installed by deploy/contabo/apply-overlay.sh server2 (root 0640). Nothing secret: the
# keys are files in /etc/valuescan/offsite/ (offsite-setup.sh sender).
#
# NEVER the kek: the executor's set holds executor.db only (backup-offsite.sh refuses a
# set with a kek, session.key or import.key). The kek is kept OFFLINE by the owner
# (executor-secrets.sh export).

OFFSITE_LABEL=server2
# Server 1, its user vsbackup (whose only command is backup-receive.sh).
OFFSITE_HOST=161.97.154.121
OFFSITE_USER=vsbackup
# executor.db within 15 minutes of a change (at least daily), the journal daily.
OFFSITE_SETS="executor journal"
OFFSITE_RATE_MBPS=10
# UTC hours for the daily journal copy (late evening in Tokyo; the copies are small).
OFFSITE_HEAVY_HOURS="04 05"
OFFSITE_FORCE_AFTER_H=20
