# /etc/valuescan/health.env on SERVER 2 (13.140.77.201, Tokyo: the copy executor only).
# Installed by deploy/contabo/apply-overlay.sh server2; read by valuescan-health.service
# after ops.env, so what is here wins. Nothing secret.
# What each setting means: deploy/server/bin/healthcheck.mjs (the header).

HEALTH_SERVER_NAME=server 2 (Tokyo: copy executor, 13.140.77.201)

# The checks of an executor-only server: no API, no index here (both are held:
# valuescan-api.service.d/hold.conf, valuescan-indexer.service.d/hold.conf).
HEALTH_CHECKS=executor,disk,backup,tls,units
HEALTH_UNITS=valuescan-executor.service,caddy.service

# CROSS-WATCH. Server 1's API through its own Caddy (gated: it gets the origin secret,
# over https only), and the public site and its API through Vercel (never the secret).
HEALTH_PEERS_GATED=api@server1=https://api.valuedesk.so/api/health
HEALTH_PEERS_PUBLIC=site=https://www.valuedesk.so/,site-api=https://www.valuedesk.so/api/health
# site-api is a call of the site's Vercel function (billed per call): every 5 min while it answers,
# every pass while it does not. The status prober takes the visitor's way every minute anyway, and the
# gated peer above watches server 1 itself every pass (healthcheck.mjs, CROSS-WATCH).
HEALTH_PUBLIC_API_EVERY_S=300

# The health check runs as valuescan and cannot read the executor's own backup
# directory (0700); the off-server copy of executor.db writes its marker where it can.
HEALTH_BACKUP_MARKERS=/var/lib/valuescan/state/offsite-executor.json
