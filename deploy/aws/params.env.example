# Copy to deploy/aws/params.env (ignored by git) and fill in. No secret belongs in
# this file: the origin secret lives in SSM Parameter Store only.
#
# Read by deploy/aws/deploy.sh and by the scripts in deploy/release.

# --- the values only the owner has ----------------------------------------------

# Region of the instance (network.yaml + compute.yaml). The edge stack always
# goes to us-east-1, whatever this says.
REGION=__REGION__                    # e.g. eu-central-1

# The site's public name and the Route 53 hosted zone that contains it.
DOMAIN_NAME=__DOMAIN__               # e.g. valuescan.example
HOSTED_ZONE_ID=__HOSTED_ZONE_ID__    # e.g. Z0123456789ABCDEFGHIJ ; empty = DNS is managed elsewhere

# Name of the instance for CloudFront and for Caddy's certificate. Any name in the
# same zone that is not the site itself.
ORIGIN_DOMAIN_NAME=origin.__DOMAIN__

# Where alarms and health alerts go (optional; the address must confirm once).
ALERT_EMAIL=

# Contact address Let's Encrypt may warn about a certificate problem (optional).
ACME_EMAIL=

# --- sizing (defaults are the tested ones) ---------------------------------------

INSTANCE_TYPE=t4g.large
# unlimited | standard | none (none for non-burstable types such as m7g.large)
CPU_CREDITS=unlimited
DATA_VOLUME_SIZE_GIB=40

# Amazon Linux 2023, arm64. Leave empty on the FIRST deploy: deploy.sh resolves the
# current image and prints it. Then paste the id here and never change it - a
# different id replaces the instance.
AMI_ID=

# Empty = the first Availability Zone of the region.
AVAILABILITY_ZONE=

# --- naming ------------------------------------------------------------------------

# Stacks are <STACK_PREFIX>-network, -compute and -edge.
STACK_PREFIX=valuescan
# SSM Parameter Store path of this environment. The origin secret is
# <CONFIG_PREFIX>/origin-secret (SecureString, created by "deploy.sh secret --execute").
CONFIG_PREFIX=/valuescan/prod

# --- edge options ------------------------------------------------------------------

PRICE_CLASS=PriceClass_All
ENABLE_WAF=true
# Requests to /api/* one address may make in 5 minutes before WAF blocks it. One
# open page makes on the order of a hundred; raise it if visitors who share an
# address (an office, a mobile carrier) are being blocked.
WAF_API_RATE_LIMIT=2000
# none | blacklist | whitelist, and ISO country codes ("US,GB"). A legal decision
# for the owner - see docs/deploy/DEPLOY.md. The site-wide list the Vercel edge
# blocks is apps/web/src/legal/jurisdictions.mjs (SANCTIONED_COUNTRIES); behind
# CloudFront use the same countries:
#   GEO_RESTRICTION_TYPE=blacklist
#   GEO_RESTRICTION_COUNTRIES=CU,IR,KP,SY,RU,BY,MM
# CloudFront cannot block regions (Crimea, Donetsk, Luhansk), and only the Vercel
# function answers /api/edge/geo, which the app's own check reads (legal/geo.ts):
# behind CloudFront that check sees an unknown place and relies on the wallet's
# declared country.
GEO_RESTRICTION_TYPE=none
GEO_RESTRICTION_COUNTRIES=
