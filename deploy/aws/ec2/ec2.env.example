# Copy to deploy/aws/ec2/ec2.env (ignored by git) and fill in. No secret belongs in
# this file. Read by deploy/aws/ec2/provision.sh and by the scripts in
# deploy/release (they talk to this instance over SSH when ec2.env exists).
#
# The values below are the test environment's since the move to Tokyo
# (docs/deploy/EC2-VERCEL.md, "Sizing and cost" and "Moving to Tokyo"). Until
# 2026-10-23 they were Frankfurt's: REGION=eu-central-1, AVAILABILITY_ZONE=eu-central-1a,
# NAME=valuescan-test, AMI_ID=ami-0fc2b4786eaf34856, the key valuescan-test.pem. An
# ec2.env made from that version IS the Frankfurt environment: leave it as it is during
# the move (the Tokyo one is ec2.tokyo.env, from ec2.tokyo.env.example, named with
# VS_EC2_ENV), and do not copy this file over it while Frankfurt still exists.

# --- the account and the region --------------------------------------------------------

# AWS CLI profile. It needs EC2 rights only (no CloudFormation, IAM, SSM or Route 53).
AWS_PROFILE=claude
REGION=ap-northeast-1
# The instance, its data volume and the subnet are in this one zone.
AVAILABILITY_ZONE=ap-northeast-1a

# Every resource carries the tags project=valuescan, env=<NAME>, role=<what>, and is
# found by them. Change NAME only for a second, separate environment.
NAME=valuescan-tokyo

# --- the instance ------------------------------------------------------------------------

INSTANCE_TYPE=t4g.medium
# unlimited | standard (burstable types only). unlimited never throttles the indexer
# and bills CPU above the baseline (0.04 USD per vCPU-hour).
CPU_CREDITS=unlimited
# Amazon Linux 2023, arm64, ap-northeast-1. The newest one, read-only, without SSM:
#   aws ec2 describe-images --profile claude --region ap-northeast-1 --owners amazon \
#     --filters 'Name=name,Values=al2023-ami-2023.*-kernel-6.1-arm64' 'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].[ImageId,Name,CreationDate]' --output text
# Pinned: provision.sh never replaces an instance whose image differs - it says so.
AMI_ID=__AMI_ID__
# Set at the launch only.
ROOT_VOLUME_GIB=16
# The data volume (/var/lib/valuescan: the index, its WAL, the backup copies, the copy
# executor's data). Can be raised any time: provision.sh grow. Sized for
# VALUESCAN_INDEX_RETAIN_DAYS=31.
DATA_VOLUME_GIB=150

# --- the data volume from a snapshot (optional) -------------------------------------------

# A snapshot in REGION the data volume is made from - used only when `up` creates the
# volume. Empty: a blank volume (bootstrap.sh formats it).
DATA_VOLUME_SNAPSHOT=
# Where `provision.sh copy-snapshot` copies a data snapshot from (another environment,
# in another region). Empty: copy-snapshot is not used.
SNAPSHOT_SOURCE_REGION=
SNAPSHOT_SOURCE_NAME=

# --- SSH ---------------------------------------------------------------------------------

# The private key provision.sh writes when it creates the key pair - outside the
# repository, never printed. The user on Amazon Linux is ec2-user.
SSH_KEY_FILE=$HOME/.ssh/valuescan-tokyo.pem
SSH_KNOWN_HOSTS=$HOME/.ssh/valuescan-tokyo.known_hosts
SSH_USER=ec2-user
# Who may reach port 22. Empty: this machine's current public IPv4 address, /32
# (asked from https://checkip.amazonaws.com). provision.sh allow-ssh moves it.
SSH_CIDR=

# --- names ----------------------------------------------------------------------------------

# The site (the Vercel production domain). The API and the executor allow it as a CORS origin.
SITE_DOMAIN=valuedeskapp.vercel.app
# The origin's DNS name: what Caddy gets its certificate for and what the Vercel
# function connects to. Empty: <elastic-ip-with-dashes>.sslip.io. With a domain of
# your own: api.<domain>, an A record to the Elastic IP (docs/deploy/EC2-VERCEL.md).
ORIGIN_DOMAIN_NAME=
# Let's Encrypt may write here about a certificate problem (optional).
ACME_EMAIL=

# Where the origin secret is kept on this machine (generated by
# deploy/release/bootstrap-instance.sh on its first run, never printed, never in git).
# The deployment's secret, the value the Vercel function has: the directory keeps the
# name of the environment it was made for.
ORIGIN_SECRET_DIR=$HOME/.valuescan/valuescan-test

# --- Vercel (the site and the /api function: deploy/release/publish-vercel.sh) -------------

VERCEL_PROJECT=valuedesk
VERCEL_SCOPE=mxer120s-projects
