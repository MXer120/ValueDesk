# deploy/aws/ec2/ec2.contabo2.env - the release environment of Contabo SERVER 2
# (13.140.77.201, Tokyo: the copy executor). Copy to ec2.contabo2.env (gitignored); use it
# with VS_EC2_ENV=deploy/aws/ec2/ec2.contabo2.env. State file .out/state.contabo2.env
# (STATE_NAME=contabo2, STATE_REGION, PUBLIC_IP=13.140.77.201).
#
# Names from the real file on the owner's laptop; public values; ACME_EMAIL left for you.

# ap-northeast-1 = Tokyo (what bootstrap.sh calls the executor's location).
REGION=ap-northeast-1
NAME=contabo2
SSH_USER=almalinux
SSH_KEY_FILE=$HOME/.ssh/valuescan-contabo
SSH_KNOWN_HOSTS=$HOME/.ssh/valuedesk-contabo2.known_hosts
SITE_DOMAIN=www.valuedesk.so
ORIGIN_DOMAIN_NAME=13-140-77-201.sslip.io
ACME_EMAIL=
# The SAME origin secret as server 1 (Caddy on server 1 forwards the edge's header).
ORIGIN_SECRET_DIR=$HOME/.valuescan/valuescan-test
