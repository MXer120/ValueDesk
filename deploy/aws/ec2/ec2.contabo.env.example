# deploy/aws/ec2/ec2.contabo.env - the release environment of Contabo SERVER 1
# (161.97.154.121, France: indexer, API, Caddy). Copy to ec2.contabo.env (gitignored) and
# use it with VS_EC2_ENV=deploy/aws/ec2/ec2.contabo.env for bootstrap-instance.sh,
# release-server.sh, remote.sh, rollback.sh. Its state file is .out/state.contabo.env
# (STATE_NAME=contabo, STATE_REGION, PUBLIC_IP=161.97.154.121).
#
# The names come from the real file on the owner's laptop (~/vs-coh/deploy/aws/ec2/);
# the values below are the public ones, ACME_EMAIL is left for you (personal data).

# What the executor and the health check call the place (no AWS is used): eu-west-3 = France.
REGION=eu-west-3
NAME=contabo
SSH_USER=almalinux
SSH_KEY_FILE=$HOME/.ssh/valuescan-contabo
SSH_KNOWN_HOSTS=$HOME/.ssh/valuedesk-contabo.known_hosts
SITE_DOMAIN=valuedeskapp.vercel.app
ORIGIN_DOMAIN_NAME=161-97-154-121.sslip.io
ACME_EMAIL=
# Where the origin secret is kept on this computer (never in git).
ORIGIN_SECRET_DIR=$HOME/.valuescan/valuescan-test
