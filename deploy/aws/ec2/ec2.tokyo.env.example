# The Tokyo environment, for the move from Frankfurt (docs/deploy/EC2-VERCEL.md,
# "Moving to Tokyo"). Copy to deploy/aws/ec2/ec2.tokyo.env (ignored by git) and fill
# in AMI_ID; later DATA_VOLUME_SNAPSHOT. No secret belongs in this file.
#
# It lives NEXT TO deploy/aws/ec2/ec2.env (Frankfurt, which stays as it is until it
# is stopped). Every script takes it when named:
#   VS_EC2_ENV=deploy/aws/ec2/ec2.tokyo.env deploy/aws/ec2/provision.sh up --print
#   VS_EC2_ENV=deploy/aws/ec2/ec2.tokyo.env deploy/release/remote.sh health
# provision.sh writes what it finds to deploy/aws/ec2/.out/state.tokyo.env (Frankfurt's
# stays in .out/state.env), and the release scripts refuse a state file of another
# environment.

# --- the account and the region --------------------------------------------------------

# AWS CLI profile. It needs EC2 rights only (no CloudFormation, IAM, SSM or Route 53).
AWS_PROFILE=claude
REGION=ap-northeast-1
# The instance, its data volume and the subnet are in this one zone.
AVAILABILITY_ZONE=ap-northeast-1a

# Every resource carries the tags project=valuescan, env=<NAME>, role=<what>, and is
# found by them. A name of its own: Frankfurt is valuescan-test.
NAME=valuescan-tokyo

# --- the instance ------------------------------------------------------------------------

INSTANCE_TYPE=t4g.medium
# unlimited | standard (burstable types only). unlimited never throttles the indexer
# and bills CPU above the baseline (0.04 USD per vCPU-hour).
CPU_CREDITS=unlimited
# Amazon Linux 2023, arm64, in ap-northeast-1. An image id belongs to one region:
# Frankfurt's (ami-0fc2b4786eaf34856) does not exist here. The newest one, read-only,
# without SSM (the profile may not use it):
#   aws ec2 describe-images --profile claude --region ap-northeast-1 --owners amazon \
#     --filters 'Name=name,Values=al2023-ami-2023.*-kernel-6.1-arm64' 'Name=state,Values=available' \
#     --query 'sort_by(Images,&CreationDate)[-1].[ImageId,Name,CreationDate]' --output text
# Put the ImageId here (and its name into this comment). Pinned: provision.sh never
# replaces an instance whose image differs - it says so.
AMI_ID=__AMI_ID__
# Set at the launch only.
ROOT_VOLUME_GIB=16
# The data volume (/var/lib/valuescan: the index, its WAL, the backup copies, the copy
# executor's data). Made from DATA_VOLUME_SNAPSHOT below it must be at least the
# snapshot's size (provision.sh refuses less); larger, the filesystem is grown after
# the bootstrap (remote.sh run 'xfs_growfs /var/lib/valuescan'). Can be raised any
# time: provision.sh grow. Sized for VALUESCAN_INDEX_RETAIN_DAYS=31.
DATA_VOLUME_GIB=150

# --- the data, from Frankfurt -----------------------------------------------------------

# Where `provision.sh copy-snapshot` takes the newest data snapshot from: the Frankfurt
# environment's region and NAME (its snapshots are tagged env=valuescan-test,
# role=data-snapshot).
SNAPSHOT_SOURCE_REGION=eu-central-1
SNAPSHOT_SOURCE_NAME=valuescan-test
# The copied snapshot in ap-northeast-1 (copy-snapshot prints its id; provision.sh status
# shows when it is completed). Used ONLY when `up` creates the data volume; empty: a
# blank volume. Once the volume exists this value changes nothing.
DATA_VOLUME_SNAPSHOT=

# --- SSH ---------------------------------------------------------------------------------

# A key pair of its own (key pairs belong to one region). provision.sh writes the
# private key when it creates the key pair - outside the repository, never printed.
# The user on Amazon Linux is ec2-user.
SSH_KEY_FILE=$HOME/.ssh/valuescan-tokyo.pem
SSH_KNOWN_HOSTS=$HOME/.ssh/valuescan-tokyo.known_hosts
SSH_USER=ec2-user
# Who may reach port 22. Empty: this machine's current public IPv4 address, /32
# (asked from https://checkip.amazonaws.com). provision.sh allow-ssh moves it.
SSH_CIDR=

# --- names ----------------------------------------------------------------------------------

# The site (the Vercel production domain). The API and the executor allow it as a CORS origin.
SITE_DOMAIN=valuedeskapp.vercel.app
# The origin's DNS name: what Caddy gets its certificate for and what the Vercel
# function connects to. Empty: <elastic-ip-with-dashes>.sslip.io - a new name, since
# Tokyo has an Elastic IP of its own. With a domain of your own: api.<domain>, an A
# record to the Elastic IP (docs/deploy/EC2-VERCEL.md).
ORIGIN_DOMAIN_NAME=
# Let's Encrypt may write here about a certificate problem (optional).
ACME_EMAIL=

# The origin secret on this machine. The SAME one as Frankfurt's on purpose: it is the
# deployment's, and the value the Vercel function already has - so moving the function
# to Tokyo needs no new Vercel variable. (rotate-origin-secret.sh then works on
# whichever environment VS_EC2_ENV names: rotate only once Frankfurt is stopped.)
ORIGIN_SECRET_DIR=$HOME/.valuescan/valuescan-test

# --- Vercel (the site and the /api function: deploy/release/publish-vercel.sh) -------------

VERCEL_PROJECT=valuedesk
VERCEL_SCOPE=mxer120s-projects
