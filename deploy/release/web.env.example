# Copy to deploy/release/web.env (ignored by git) and fill in. These are the
# BUILD-TIME settings of the production web bundle: Vite inlines every VITE_*
# value into public JavaScript. NOTHING HERE IS A SECRET - and no secret may ever
# be given a VITE_ name.
#
# Read by deploy/release/build-web.sh. Every variable below is exported to the
# build, set or empty, so a stray apps/web/.env.local on the build machine cannot
# leak a development value into a production build.
#
# Reference: apps/web/src/trading/config.ts, apps/web/src/walletconnect.ts.

# --- required for launch ---------------------------------------------------------

# WalletConnect / Reown project id. Without it "Connect wallet" cannot open the
# wallet list or pair by QR code (injected browser wallets still appear).
# Create a project at https://dashboard.reown.com and add the production domain
# to its allowed domains.
VITE_WALLETCONNECT_PROJECT_ID=__WALLETCONNECT_PROJECT_ID__

# The Discord invite behind the feedback form's Discord button (https only; empty: "coming soon").
VITE_FEEDBACK_URL=https://discord.gg/TVJKHY9vhK

# --- builder fee (the revenue; being finished by the builder-codes work) ----------
#
# Leave all four empty and no builder fee is approved or charged. Re-check the
# names and ranges against apps/web/src/trading/config.ts before the first release.

# Valuescan's SoDEX builder account id (a positive integer).
VITE_BUILDER_ID=
# Fee per perps order, in TENTHS of a basis point (0..200). 10 = 1 bp = 0.01 %.
VITE_BUILDER_FEE_PERPS=
# Fee per spot order, in tenths of a basis point (0..2000).
VITE_BUILDER_FEE_SPOT=
# The ceiling a user approves once, in tenths of a basis point (0..2000). Empty =
# the higher of the two fees. A ceiling below a fee switches the builder off.
VITE_BUILDER_MAX_FEE=
# Empty or 1: with a builder id, trading through Valuescan REQUIRES the approval.
# 0: the fee is optional (a user who declines trades without it) - test builds only;
# build-web.sh --public refuses it.
VITE_BUILDER_REQUIRED=
# Ed25519 public keys of the server that may LOWER a wallet's fee (per-wallet tiers,
# docs/deploy/DEPLOY.md section 16): the publicKey builderTiers.ts init prints,
# base64url, comma separated while a key is replaced. Empty: every wallet pays the
# two fees above.
VITE_BUILDER_TERMS_KEYS=

# --- network ------------------------------------------------------------------------

# Pin the network into the bundle: mainnet | testnet. Pinned, the API cannot move
# the app to another network (a mismatch only ever turns trading off). Empty =
# follow what /api/health reports.
VITE_SODEX_NETWORK=mainnet

# Gateway origin override, https://host with no path. Empty = SoDEX's own gateway.
# A custom gateway must also be added to the CSP (edge.yaml, apps/web/index.html)
# and to the SharedWorker's allow-list - see docs/deploy/SECURITY-HEADERS.md 1.2.1.
VITE_SODEX_GATEWAY=

# --- switches -------------------------------------------------------------------------

# 1 = allow mainnet trading even when the API reports mainnetWritesAllowed: false.
# Leave empty: then VALUETRADE_ALLOW_MAINNET=0 on the server is an emergency brake.
VITE_ALLOW_MAINNET_TRADING=

# 1 = an emergency build with every write refused in the browser.
VITE_TRADING_DISABLED=

# Trading key lifetime in hours (1..168). Empty = 168 (7 days).
VITE_TRADING_KEY_TTL_H=

# tradingview = use TradingView Advanced Charts. Needs the licensed library in
# apps/web/public/charting_library (not in the repository) and a CSP review.
# Leave empty for the built-in chart.
VITE_CHART=
