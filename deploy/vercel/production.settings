# The production site's build settings when Vercel builds a commit itself
# (vercel.json -> deploy/vercel/build.sh). The same names and meaning as
# deploy/release/web.env.example, plus the origin.
#
# Committed on purpose: NOTHING HERE IS A SECRET. Every VITE_* value is inlined
# into the public JavaScript of the site, and the origin is a public DNS name.
# A secret never goes here - the origin secret is the Vercel environment variable
# VALUESCAN_ORIGIN_SECRET (production only, sensitive).
#
# A change here reaches the site with the next production deployment of main.

# The server behind /api/* (its Caddy passes /api/copy/* on to the copy executor on server 2,
# 13.140.77.201 in Japan):
# Contabo server 1 (161.97.154.121, since 2026-10-25) by its own name api.valuedesk.so (A record at
# Namecheap, 2026-10-27; Caddy still serves the old 161-97-154-121.sslip.io beside it).
VALUESCAN_ORIGIN=api.valuedesk.so

# The live liquidation heatmap's WebSocket: straight to the instance (Vercel's functions hold no
# socket); Caddy passes this one path without the origin secret (deploy/server/caddy/Caddyfile.template).
VITE_LIQ_WS_URL=wss://api.valuedesk.so/ws/liq

VITE_WALLETCONNECT_PROJECT_ID=ea518a95b8c4040554a878d2a9ed1b39

# ValueDesk's SoDEX builder account; 1.5 bp per order, 2.5 bp ceiling (the copy
# fee ladder's top tier, packages/copy-engine/src/policy.ts COPY_FEE_MAX).
VITE_BUILDER_ID=221909
VITE_BUILDER_FEE_PERPS=15
VITE_BUILDER_FEE_SPOT=15
VITE_BUILDER_MAX_FEE=25
VITE_BUILDER_REQUIRED=
VITE_BUILDER_TERMS_KEYS=OsA3xzwLL7bwWLXEYIP7VJdYmvjnfNwnZtHNmsaJgyI

VITE_SODEX_NETWORK=mainnet
VITE_SODEX_GATEWAY=

# The owner turned trading on for this deployment (2026-10-04).
VITE_ALLOW_MAINNET_TRADING=1
VITE_TRADING_DISABLED=
VITE_TRADING_KEY_TTL_H=
VITE_CHART=
